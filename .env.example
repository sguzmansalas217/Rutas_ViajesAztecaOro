# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env y llena los valores. EL .env NUNCA SE SUBE A GIT.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
TZ=America/Mexico_City

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_DB=monitoreo
POSTGRES_USER=monitoreo
POSTGRES_PASSWORD=cambiame_por_algo_largo_y_aleatorio
DATABASE_URL=postgres://monitoreo:cambiame_por_algo_largo_y_aleatorio@db:5432/monitoreo

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── API ──────────────────────────────────────────────────────────────────────
PUERTO=3000
# Genera uno con:  openssl rand -hex 48
JWT_SECRETO=cambiame_openssl_rand_hex_48
# Dominio público del sistema (sin barra final)
URL_PUBLICA=https://monitoreo.tudominio.com

# Usuario administrador que se crea en el primer arranque
ADMIN_CORREO=sguzmansalas217@gmail.com
ADMIN_CLAVE=cambiame_en_el_primer_acceso
ADMIN_NOMBRE=Sergio Daniel Guzman Salas

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
WA_ID_NUMERO=
WA_ID_CUENTA=
WA_TOKEN=
# Cadena que tú inventas y capturas igual en el panel de Meta
WA_VERIFY_TOKEN=cambiame_cadena_larga
# App Secret de Meta. Con esto se valida la firma X-Hub-Signature-256.
WA_APP_SECRET=
# Opcional. Sólo lo usa `npm run wa` para preguntarle a Meta cuándo vence el
# token: sin esto no se detecta el error típico de usar el token temporal de
# 24 horas en lugar del permanente de usuario del sistema.
WA_APP_ID=
# Poner en 1 para no enviar mensajes reales (desarrollo)
WA_SIMULADO=1

# ── Despliegue ───────────────────────────────────────────────────────────────
# Sólo se usan en tu máquina, por ./desplegar.sh. En el servidor se ignoran.
DESPLIEGUE_HOST=despliegue@000.000.000.000
DESPLIEGUE_RUTA=/opt/monitoreo-rutas
DESPLIEGUE_RAMA=main
